# Template sem credenciais. Preencher somente no gerenciador de secrets do executor.
SEBASTIAN_STORE_DRIVER=supabase
# Secret: URL completa do banco dev; não preencher este arquivo no Git.
# Direto: usuário sebastian_app. Session Pooler: sebastian_app.smtyixukyexezjumouvw.
SEBASTIAN_SUPABASE_DATABASE_URL=
# Se necessária uma CA própria, montar o certificado de Supabase e configurar seu caminho:
# SEBASTIAN_SUPABASE_CA_FILE=/run/secrets/sebastian-supabase-ca.crt
# Diagnóstico: direct (padrão) ou session-pooler; não há fallback automático.
SEBASTIAN_SUPABASE_CONNECTION_MODE=session-pooler
# Host confirmado pelo usuário no painel Supabase.
SEBASTIAN_SUPABASE_SESSION_POOLER_HOST=aws-1-us-west-2.pooler.supabase.com
# Runner isolado: recebe apenas o caminho de um secret montado, nunca a senha em argumento.
# SEBASTIAN_SUPABASE_PASSWORD_FILE=/run/secrets/sebastian_app_dev_password
