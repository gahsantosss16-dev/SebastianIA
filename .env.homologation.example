# Template sem credenciais. Preencher somente no gerenciador de secrets do executor.
SEBASTIAN_STORE_DRIVER=supabase
# Secret: URL completa do banco dev, usuário sebastian_app; não preencher este arquivo no Git.
SEBASTIAN_SUPABASE_DATABASE_URL=
# Se necessária uma CA própria, montar o certificado de Supabase e configurar seu caminho:
# SEBASTIAN_SUPABASE_CA_FILE=/run/secrets/sebastian-supabase-ca.crt
